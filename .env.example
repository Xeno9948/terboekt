# Home Terboekt booking backend
# Copy to .env at the repo root (gitignored). Never put secrets in public/assets/js/.

APP_BASE_URL=http://localhost:8080
APP_ENV=local
APP_KEY=

# Timezone used for stay dates and admin timestamps
APP_TIMEZONE=Europe/Brussels

# --- Database ---
# Local default (no MySQL required): leave DATABASE_URL as sqlite.
# Railway: leave DATABASE_URL empty and set MYSQL_URL from the MySQL plugin
# (or reference ${{MySQL.MYSQL_URL}} on the web service).
DATABASE_URL=sqlite:backend/storage/terboekt.sqlite
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Airbnb iCal (server-side only; never expose to frontend JS) ---
AIRBNB_ICAL_URL=

# Token required to download the private "Unavailable" feed
# GET {APP_BASE_URL}/api/ical?token=...
ICAL_EXPORT_SECRET=

# Cron secret (falls back to ICAL_EXPORT_SECRET if empty).
# Combell: every 15 minutes, GET https://hometerboekt.be/api/cron.php?token=...
# CLI: php backend/bin/cron.php
CRON_SECRET=

# --- SMTP (leave blank until credentials exist; booking still persists) ---
SMTP_HOST=
SMTP_PORT=587
# ssl = implicit TLS (465). tls = STARTTLS (587). empty = no encryption (local only).
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@hometerboekt.be
SMTP_FROM_NAME=Home Terboekt
SMTP_REPLY_TO=info@hometerboekt.be
MANAGER_EMAIL=info@hometerboekt.be

# Initial admin is created with: php backend/bin/create-admin.php
# Do not put a production password in this file.
# ADMIN_SETUP_EMAIL=
# ADMIN_SETUP_PASSWORD=
